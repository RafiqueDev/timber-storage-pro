PORT=4000
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
PORTAL_JWT_SECRET=change_this_party_portal_secret
PORTAL_BASE_URL=http://localhost:5173
DB_FILE=./timber.db
TIMEZONE=Asia/Karachi
LOW_STOCK_THRESHOLD=25
# NODE_ENV=production
# In production, JWT_ACCESS_SECRET / JWT_REFRESH_SECRET / PORTAL_JWT_SECRET
# MUST all be set to unique, random values (e.g. `openssl rand -hex 32`) —
# the server refuses to start with NODE_ENV=production if any are left as
# defaults.
